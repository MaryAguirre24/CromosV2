@using Shared.DTOs.Categorias
@inject IHttpServicio Http
@inject NavigationManager Navigation

@if(Mostrar)
{
    <div class="cromo-modal-overlay">
        <div class="cromo-modal-card">
            <div class="cromo-modal-header">
                <h3>Buscar Cromos</h3>
                <button class="btn-close-red" @onclick="CerrarModal">&times;</button>
            </div>
            <div class="cromo-modal-body">
                <div class="field-row">
                    <div class="field-group">
                        <label>Nombre</label>
                        <input type="text" class="cromo-input" @bind="filtros.Nombre" />
                    </div>
                    <div class="indicator-box @(!string.IsNullOrWhiteSpace(filtros.Nombre) ? "active" : "")"></div>
                </div>
            </div>
            <div class="field-row">
                <div class="field-group">
                    <label>Categoría</label>
                    <select class="cromo-select" @bind="filtros.CategoriaId">
                        <option value="0">Seleccionar...</option>
                        @if (categorias != null)
                        {
                            @foreach (var c in categorias)
                            {
                                <option value="@c.Id">@c.Nombre</option>
                            }
                        }
                    </select>
                </div>
                <div class="indicator-box @(filtros.CategoriaId.HasValue && filtros.CategoriaId > 0 ? "active" : "")"></div>
            </div>
            <div class="field-row">
                <div class="field-group">
                    <label>Rango de Stock</label>
                    <div class="range-container">
                        <input type="number" class="range-input" @bind="filtros.StockMin" placeholder="Min." />
                        <div class="range-divider"></div>
                        <input type="number" class="range-input" @bind="filtros.StockMax" placeholder="Max." />
                    </div>
                </div>
                <div class="indicator-box @(filtros.StockMin.HasValue || filtros.StockMax.HasValue ? "active" : "")"></div>
            </div>
            <div class="field-row">
                <div class="field-group">
                    <label>Rango de Precio</label>
                    <div class="range-container">
                        <input type="number" step="0.01" class="range-input" @bind="filtros.PrecioMin" placeholder="Min." />
                        <div class="range-divider"></div>
                        <input type="number" step="0.01" class="range-input" @bind="filtros.PrecioMax" placeholder="Max." />
                    </div>
                </div>
                <div class="indicator-box @(filtros.PrecioMin.HasValue || filtros.PrecioMax.HasValue ? "active" : "")"></div>
            </div>
            <div class="cromo-modal-footer">
                <button class="btn-buscar-green" @onclick="AplicarBusqueda">Buscar</button>
            </div>
        </div>

    </div>
}
@code {
    [Parameter] public bool Mostrar { get; set; }
    [Parameter] public EventCallback<bool> MostrarChanged { get; set; }
    [Parameter] public EventCallback<BusquedaAvanzadaDTO> OnSearch { get; set; }

    private BusquedaAvanzadaDTO filtros = new();
    private List<ListaCategoriaDTO> categorias = new();

    protected override async Task OnInitializedAsync()
    {
        await CargarCategorias();
    }
    
    private async Task CargarCategorias()
    {
        try
        {
            var response = await Http.Get<List<ListaCategoriaDTO>>("api/admin/categorias/listacategorias");
            if (response != null)
            {
                categorias = response.Respuesta;

            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar categorías: {ex.Message}");
        }
    }
    private async Task CerrarModal()
    {
        Mostrar = false;
        await MostrarChanged.InvokeAsync(Mostrar);
    }
    private async Task AplicarBusqueda()
    {
        await OnSearch.InvokeAsync(filtros);
        await CerrarModal();
    }

}
