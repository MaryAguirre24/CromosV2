@page "/Producto/lista"
@using Shared.DTOs.Categorias
@using Shared.DTOs.Productos
@layout AdminLayout
@inject IHttpServicio Http
@inject NavigationManager Navigation

<PageTitle>Productos - Cromos</PageTitle>

<div class="productos-container">
    <div class="barra-productos">
        <h2 class="titulo-productos">Lista de Productos</h2>
    </div>
    <br />
    <div class="acciones-productos">
        <button type="button" class="btn-nuevo" @onclick="AbrirModalCrear">
            <i class="bi bi-plus-square"></i>
            <span>Nuevo Producto</span>
        </button>
        <ModalCrearProducto @bind-Mostrar="verModalCrear" OnProductoGuardado="CargarLista" />

        <button type="button" class="btn-buscar" @onclick="AbrirModalBuscar">
            <i class="bi bi-search"></i>
            <span>Búsqueda Avanzada</span>
        </button>
        <ModalBusquedaAvanzada @bind-Mostrar="verModalBuscar" OnSearch="AplicarBusquedaAvanzada" />
    </div>
     <br />
    <div class="contenido-productos">
        <table class="table">
            <thead class="table-productos">
                <tr>
                    <th>Codigo</th>
                    <th>Nombre</th>
                    <th>Descripcion</th>
                    <th>Precio</th>
                    <th>Stock</th>
                    <th>Categoria</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (productos == null)
                {
                    <tr>
                        <td colspan="7" class="text-center py-4">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                            <p class="mt-2 text-muted mb-0">Cargando productos...</p>
                        </td>
                    </tr>
                }
                else if (!productos.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                            No hay productos registrados.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var producto in productos)
                    {
                        <tr>
                            <td class="fw-bold">@producto.Codigo</td>
                            <td>@producto.Nombre</td>
                            <td>@producto.Descripcion</td>
                            <td>@producto.PrecioVenta.ToString("C0")</td>
                            <td>@producto.Stock</td>
                            <td>@producto.CategoriaNombre</td>
                            <td>
                                <button class="btn btn-warning btn-sm me-1 text-dark"
                                        title="Editar"
                                        @onclick="() => CargarDatosEditar(producto.Id)">
                                    <i class="bi bi-pencil-fill"></i>
                                </button>

                                <button class="btn btn-danger btn-sm"
                                        title="Eliminar"
                                        @onclick="() => DesactivarProducto(producto.Id, producto.Nombre)">
                                    <i class="bi bi-trash-fill"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private List<ListaProductoDTO>? productos;
    private bool verModalCrear = false;
    private bool verModalBuscar = false;
    string Mensaje = "";


    protected override async Task OnInitializedAsync()
    {
        await CargarLista();
    }

    private async Task CargarLista()
    {
        try
        {
            var response = await Http.Get<List<ListaProductoDTO>>("api/Producto/lista");
            if (response != null)
            {
                productos = response.Respuesta;
            }
            else
            {
                Mensaje = "No se pudieron cargar los productos.";
            }
        }
        catch (Exception ex)
        {
            Mensaje = $"Error al cargar los productos: {ex.Message}";
        }
    }
    private async Task AplicarBusquedaAvanzada(BusquedaAvanzadaDTO filtros)
    {
        try
        {
            var response = await Http.Post<BusquedaAvanzadaDTO, List<ListaProductoDTO>>("api/Producto/lista/busquedaavanzada", filtros);
            if (response != null)
            {
                productos = response.Respuesta;
            }
            else
            {
                Mensaje = "No se pudieron aplicar los filtros de búsqueda.";
            }
        }
        catch (Exception ex)
        {
            Mensaje = $"Error al aplicar la búsqueda avanzada: {ex.Message}";
        }
    }
    private void AbrirModalCrear()
    {
        verModalCrear = true;
        StateHasChanged();
    }
    private void AbrirModalBuscar()
    {
        verModalBuscar = true;
        StateHasChanged();
    }
    private async Task CargarDatosEditar(int productoId)
    {
        try
        {
            var response = await Http.Get<ActualizarProductoDTO>($"api/Producto/obtener-producto/{productoId}");
            if (response?.Respuesta != null)
            {
                var productoParaEditar = response.Respuesta;
                Navigation.NavigateTo($"/producto/editar/{productoId}");
            }
            else
            {
                Mensaje = "No se pudo cargar la información del producto para editar.";
            }
        }
        catch (Exception ex)
        {
            Mensaje = $"Error al cargar el producto: {ex.Message}";
        }
    }
    private async Task DesactivarProducto(int productoId, string nombreProducto)
    {
    }

}
